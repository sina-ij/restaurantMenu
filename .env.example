# آدرس اتصال به دیتابیس پستگرس (برای کوئری‌های معمول برنامه)
# مثال لوکال: postgresql://postgres:password@localhost:5432/restaurant_menu
# اگه از Supabase استفاده می‌کنی، این همون connection string بخش
# "Transaction pooler" هست (پورت ۶۵۴۳ و ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_menu"

# فقط وقتی از یک پولر مثل pgbouncer (مثلاً Supabase) استفاده می‌کنی لازمه.
# این همون connection string بخش "Session pooler" یا "Direct connection"
# هست (پورت ۵۴۳۲، بدون pgbouncer=true) و فقط موقع اجرای migration استفاده
# می‌شه. برای پستگرس لوکال می‌تونی همون DATABASE_URL رو اینجا هم بذاری.
DIRECT_URL="postgresql://user:password@localhost:5432/restaurant_menu"

# یک رشته‌ی طولانی و تصادفی برای امضای JWT (هرگز عمومی نکن)
JWT_SECRET="a-very-long-random-secret-string-change-this"
