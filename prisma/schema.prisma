generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(OWNER)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant?
}

model Restaurant {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  description  String?
  logoUrl      String?
  phone        String?
  address      String?
  workingHours String?
  locationUrl  String?
  instagram    String?
  businessType String?
  accentColor  String     @default("#AB7C33")
  pattern      String?
  viewCount    Int        @default(0)
  owner        User       @relation(fields: [ownerId], references: [id])
  ownerId      String     @unique
  categories   Category[]
  dailyStats   DailyStat[]
  createdAt    DateTime   @default(now())
}

model DailyStat {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  day          DateTime
  count        Int        @default(0)

  @@unique([restaurantId, day])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  imageUrl     String?
  order        Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  items        MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  available   Boolean  @default(true)
  order       Int      @default(0)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  createdAt   DateTime @default(now())
}
